# GMI Cloud, used for image, video, audio and chat generation.
GMI_API_KEY=

# Backblaze B2 application key, scoped to the hallmark bucket only.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=hallmark-media
# Required, not optional. Some B2 regions (us-east-005 among them) reject
# cross-region requests with 403 rather than a redirect, so region auto-detect
# cannot work. Run scripts/check_b2.py to find yours.
B2_REGION=us-east-005
B2_ENDPOINT=

# Public base URL of the verify page, written into manifest pointers.
HALLMARK_VERIFY_BASE=http://localhost:3000/v
